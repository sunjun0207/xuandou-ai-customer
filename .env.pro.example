# 正式环境。容器里的 127.0.0.1 到不了宿主机上的 frp。页面走 http://主机:4100 时 COOKIE_SECURE 必须是 false。
NODE_ENV=production
TZ=Asia/Shanghai
HTTP_ADDR=0.0.0.0:4100
TLS_ENABLE=false
FRP_HTTP_URL=https://prev-frp.xuandou.vip
FRP_WS_URL=wss://prev-frp.xuandou.vip/ws
FRP_CONNECT_TIMEOUT_MS=8000
DEV_AUTH=false
CUSTOMER_SECRET=change-me
COOKIE_SECURE=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=xuandou2
QINIU_REGION=z0
QINIU_PUBLIC_DOMAIN=https://qiniu2.xuandou.vip
QINIU_UPLOAD_DOMAIN=https://up-z2.qiniup.com
QINIU_USE_HTTPS=true
UPLOAD_MAX_BYTES=104857600
