# 正式环境。与 frp 同机时走本机 4080。分开部署时把下面两个地址改成 https://prev-frp.xuandou.vip 和 wss://prev-frp.xuandou.vip/ws。
NODE_ENV=production
TZ=Asia/Shanghai
HTTP_ADDR=0.0.0.0:4100
TLS_ENABLE=false
FRP_HTTP_URL=http://127.0.0.1:4080
FRP_WS_URL=ws://127.0.0.1:4080/ws
FRP_CONNECT_TIMEOUT_MS=8000
DEV_AUTH=false
CUSTOMER_SECRET=xuandou-ai-customer-pro-secret
COOKIE_SECURE=true
