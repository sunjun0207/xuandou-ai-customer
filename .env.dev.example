# 本地开发。npm run dev 加载 .env.dev，请求本机 xuandou-frp-server。
NODE_ENV=development
TZ=Asia/Shanghai
HTTP_ADDR=0.0.0.0:4100
TLS_ENABLE=false
FRP_HTTP_URL=http://127.0.0.1:44080
FRP_WS_URL=ws://127.0.0.1:44080/ws
FRP_CONNECT_TIMEOUT_MS=8000
DEV_AUTH=true
DEV_USERNAME=admin
DEV_PASSWORD=change-me
CUSTOMER_SECRET=change-me
COOKIE_SECURE=false
